data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"## This is the offline demo\n\nThe two tool calls above were **real**: they ran in this editor and their results are in the cards. "}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Everything I say is scripted, so I am not reading your message.\n\n"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"With a model connected, a turn looks the same:\n\n- I read the editor with tools such as `editor_get_context` and `asset_search`.\n"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"- I load a skill before work it covers.\n- Changes go through the undo history, and dangerous tools ask you first.\n\n"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Code arrives in blocks you can copy:\n\n```cpp\nUPROPERTY(EditAnywhere, Category = \"Demo\")\nfloat WalkSpeed = 600.0f;\n```\n\n"}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"To talk to a real model, restart the editor without `-CursorUnrealDemo` and add a key in the **Setup** tab."}}

